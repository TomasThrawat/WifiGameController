<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="#0D0D0D">

    <!-- Joystick: LEFT side, anchored to bottom -->
    <com.tomasthrawat.wificontroller.JoystickView
        android:id="@+id/joystick"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="32dp" />

    <!-- D-pad: built upward from a fixed gap above the joystick so it never touches it -->
    <Button
        android:id="@+id/btnDown"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="@string/dpad_down"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toTopOf="@id/joystick"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnUp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="@string/dpad_up"
        app:layout_constraintLeft_toLeftOf="@id/btnDown"
        app:layout_constraintBottom_toTopOf="@id/btnDown"
        android:layout_marginBottom="72dp" />

    <Button
        android:id="@+id/btnLeft"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="@string/dpad_left"
        app:layout_constraintRight_toLeftOf="@id/btnUp"
        app:layout_constraintTop_toTopOf="@id/btnUp"
        app:layout_constraintBottom_toBottomOf="@id/btnDown"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnRight"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="@string/dpad_right"
        app:layout_constraintLeft_toRightOf="@id/btnUp"
        app:layout_constraintTop_toTopOf="@id/btnUp"
        app:layout_constraintBottom_toBottomOf="@id/btnDown"
        android:layout_marginStart="8dp" />

    <!-- A/B/X/Y: RIGHT side, plus shape: X above, A..B row with a center gap, Y below -->
    <Button
        android:id="@+id/btnB"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="B"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="64dp"
        android:layout_marginTop="120dp" />

    <Button
        android:id="@+id/btnA"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="A"
        app:layout_constraintRight_toLeftOf="@id/btnB"
        app:layout_constraintTop_toTopOf="@id/btnB"
        app:layout_constraintBottom_toBottomOf="@id/btnB"
        android:layout_marginEnd="80dp" />

    <Button
        android:id="@+id/btnX"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="X"
        app:layout_constraintLeft_toLeftOf="@id/btnA"
        app:layout_constraintRight_toRightOf="@id/btnB"
        app:layout_constraintBottom_toTopOf="@id/btnA"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnY"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="Y"
        app:layout_constraintLeft_toLeftOf="@id/btnA"
        app:layout_constraintRight_toRightOf="@id/btnB"
        app:layout_constraintTop_toBottomOf="@id/btnA"
        android:layout_marginTop="16dp" />

    <!-- Start/Select: bottom center -->
    <Button
        android:id="@+id/btnSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="80dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start"
        app:layout_constraintLeft_toRightOf="@id/btnSelect"
        app:layout_constraintBottom_toBottomOf="@id/btnSelect"
        android:layout_marginStart="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
